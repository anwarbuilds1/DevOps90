# ==============================================================================
# Supabase Database Configuration
# ==============================================================================
# 1. Go to your Supabase Project Dashboard (https://supabase.com/dashboard)
# 2. Click "Project Settings" (gear icon) -> "Database"
# 3. Under "Connection string", select "URI" (or "Transaction pooler" / "Session pooler")
# 4. Paste it below and replace [YOUR-PASSWORD] with your database password:
#
# Direct connection example:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
#
# Or connection pooler (recommended for serverless / Next.js):
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"

DATABASE_URL=""

# Optional: Supabase API credentials if using the JavaScript SDK directly
# NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
